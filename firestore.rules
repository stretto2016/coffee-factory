rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 관리자(사장님) 확인
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "strettopark@gmail.com";
    }

    // 2. 상품(내부용): 실제 배합비(composition)·원가·B2B 납품가가 들어 있으므로 공개 금지.
    // 거래처(이메일 로그인)와 사장님만 읽을 수 있다.
    // 홈페이지 방문자는 익명 로그인 상태이므로 request.auth != null 만으로는 부족하다 —
    // 익명 제공자를 명시적으로 배제한다.
    function isSignedInPartner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /products/{document=**} {
      allow read: if isAdmin() || isSignedInPartner();
      allow write: if isAdmin();
    }

    // 2-1. 상품(공개용 미러): 홈페이지 Shop·원두 추천이 읽는다.
    // Cloud Function syncPublicProduct가 products에서 공개 가능한 필드만 복사해 생성한다.
    // 배합비는 별도 입력한 공개용(displayComposition)만 들어 있고 원가는 없다.
    match /publicProducts/{document=**} {
      allow read: if true;
      allow write: if isAdmin(); // 실제 쓰기는 Admin SDK(Cloud Function)가 규칙을 우회해 수행
    }

    // 3. 주문: 로그인한 사람만
    // 거래처 본인 확인 (clients 문서의 email 또는 loginId 기준)
    function isClientOwner(clientId) {
      let c = get(/databases/$(database)/documents/clients/$(clientId)).data;
      return request.auth != null && (
        c.email == request.auth.token.email
        || (('loginId' in c) && (
          (c.loginId + '@stretto.com') == request.auth.token.email
          || (c.loginId + '@stretto.co.kr') == request.auth.token.email
          || c.loginId == request.auth.token.email
        ))
      );
    }
    match /orders/{orderId} {
      allow create, read, delete: if request.auth != null;
      allow write: if isAdmin();
      // 선주문(isPrepaid) 차감: 해당 거래처 본인이 출고량/이력 필드만, 잔량 초과 없이 증가시키는 경우 허용
      allow update: if isAdmin() || (
        resource.data.isPrepaid == true
        && isClientOwner(resource.data.clientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shippedAmount', 'drawHistory', 'isShipped'])
        && request.resource.data.shippedAmount is number
        && request.resource.data.shippedAmount > resource.data.shippedAmount
        && request.resource.data.shippedAmount <= resource.data.amountKg
      );
    }

    // 4. 거래처 정보
    match /clients/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 5. 1:1 상담 채팅: 사장님은 전체, 거래처는 자기 방만, 홈페이지 방문자(익명)는 자기 방만
    function isRoomOwner(clientId) {
      return request.auth != null
        && get(/databases/$(database)/documents/clients/$(clientId)).data.email == request.auth.token.email;
    }
    // 홈페이지 방문자: 익명 로그인 uid가 곧 방 ID (uid == roomId 인 방만 접근 허용)
    function isGuestOwner(roomId) {
      return request.auth != null && request.auth.uid == roomId;
    }
    match /chats/{clientId} {
      // 읽기: 사장님 / 거래처 본인 / 방문자 본인 (게스트 검사를 먼저 두어 없는 clients 문서 조회 방지)
      allow read: if isAdmin() || isGuestOwner(clientId) || isRoomOwner(clientId);
      // 방 생성/수정: 방문자는 이름·연락처가 반드시 있어야 함 (스팸 방지)
      // 게스트 검사를 먼저 두어, 존재하지 않는 clients 문서를 조회하다 에러나는 것을 방지
      allow create, update: if isAdmin() || (
        isGuestOwner(clientId)
        && request.resource.data.clientName is string && request.resource.data.clientName.size() > 0
        && request.resource.data.guestPhone is string && request.resource.data.guestPhone.size() > 0
      ) || isRoomOwner(clientId);
      allow delete: if isAdmin(); // 삭제는 사장님만

      match /messages/{messageId} {
        allow read: if isAdmin() || isGuestOwner(clientId) || isRoomOwner(clientId);
        // 방문자 메시지: sender는 client 고정, 텍스트 길이 제한 (게스트 검사를 먼저)
        allow create: if isAdmin() || (
          isGuestOwner(clientId)
          && request.resource.data.sender == 'client'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 2000
        ) || isRoomOwner(clientId);
        allow update: if isAdmin() || isGuestOwner(clientId) || isRoomOwner(clientId);
        allow delete: if isAdmin(); // 삭제는 사장님만
      }
    }

    // 6. 머신 수리 상담 신청: 홈페이지 방문자 누구나 접수 가능, 열람/처리는 사장님만
    match /repairRequests/{requestId} {
      allow create: if request.resource.data.repName is string
        && request.resource.data.repName.size() > 0
        && request.resource.data.repPhone is string
        && request.resource.data.repPhone.size() > 0
        && request.resource.data.symptom is string
        && request.resource.data.symptom.size() > 0
        && request.resource.data.symptom.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // 7. 홈페이지 검토 코멘트(?review 모드): 화면을 보며 남기는 수정 요청 메모.
    //    실제 사이트 콘텐츠에는 아무 영향이 없고, 여기에 접근해도 다른 컬렉션은 읽지 못한다.
    //    리뷰 모드의 비밀번호는 화면 진입만 막는 용도이므로 규칙 차원에서는 검사하지 않는다.
    match /reviewComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.page is string
        && request.resource.data.selector is string
        && request.resource.data.memo is string
        && request.resource.data.memo.size() < 2000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() < 20;
      allow update: if isAdmin();
      allow delete: if request.auth != null;
    }

    // 8. 기타 관리자 접근
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
