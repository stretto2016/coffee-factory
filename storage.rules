rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "strettopark@gmail.com";
    }

    // 수리 상담 사업자등록증 업로드: 누구나 업로드 가능(10MB, 이미지/PDF만)
    // 파일명에 무작위 UUID가 포함되어 URL을 아는 사람만 접근 가능 (덮어쓰기 불가)
    match /repairUploads/{fileName} {
      allow create: if request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // 홈페이지 리뷰 모드(?review): 바꿀 사진 · 화면에 그린 그림 캡처
    // 익명 로그인한 리뷰 화면에서만 올린다 (15MB 이하 이미지, 덮어쓰기 불가, 지우기는 리뷰 화면에서 가능)
    match /reviewUploads/{fileName} {
      allow create: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if request.auth != null;
    }

    // 그 외 경로는 사장님만
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
